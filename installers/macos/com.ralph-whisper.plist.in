<?xml version="1.0" encoding="UTF-8"?>
<!-- launchd autostart for ralph-whisper (macOS). UNTESTED template.
     1. Edit @PYTHON@ to your venv python and @REPO@ to the checkout path.
     2. Copy to ~/Library/LaunchAgents/com.ralph-whisper.plist
     3. launchctl load ~/Library/LaunchAgents/com.ralph-whisper.plist
     Grant the terminal/Python Accessibility + Input Monitoring permissions. -->
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN"
  "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key><string>com.ralph-whisper</string>
  <key>ProgramArguments</key>
  <array>
    <string>@PYTHON@</string>
    <string>-m</string>
    <string>ralph_whisper</string>
  </array>
  <key>WorkingDirectory</key><string>@REPO@</string>
  <key>RunAtLoad</key><true/>
  <key>KeepAlive</key><true/>
  <key>StandardErrorPath</key><string>/tmp/ralph-whisper.err</string>
  <key>StandardOutPath</key><string>/tmp/ralph-whisper.out</string>
</dict>
</plist>
